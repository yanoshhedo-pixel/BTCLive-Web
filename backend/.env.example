# Backend Environment Configuration
# Copy this file to .env and configure as needed

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./btclive.db

# Signal Mode
# Options: more_action (higher frequency), conservative (higher quality)
MODE=more_action

# Reversal Signal Thresholds
REVERSAL_MIN_SWEEP_SIZE=50000
REVERSAL_MIN_REJECTION_SPEED=0.8
REVERSAL_MIN_SCORE=0.6

# Continuation Signal Thresholds
CONTINUATION_MIN_ABSORPTION=100000
CONTINUATION_MIN_BREAK_STRENGTH=0.7
CONTINUATION_MIN_SCORE=0.65

# VWAP Snapback Thresholds
VWAP_SNAPBACK_MIN_DEVIATION=0.002
VWAP_SNAPBACK_MIN_SCORE=0.55

# Alert Settings
ALERT_COOLDOWN_SECONDS=30
MAX_ALERTS_PER_MINUTE=10

# Order Book Settings
ORDERBOOK_DEPTH=20
ORDERBOOK_UPDATE_THROTTLE_MS=100
